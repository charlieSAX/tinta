          },
          {
            "q": "Que defienden los lefebvrianos respecto a la misa?",
            "type": "open"
          },
          {
            "q": "Crees que sera posible una reconciliacion en el futuro? Por que?",
            "type": "open"
          }
        ],
        "opinion_prompt": "Piensas que las instituciones religiosas deben adaptarse a los tiempos modernos o conservar sus tradiciones? Argumenta tu opinion."
      }
