            "pos": "noun",
            "back": "supply",
            "example": "El abastecimiento de alimentos sigue siendo normal.",
            "tier": "B2"
          },
          {
            "front": "minimizar",
            "pos": "verb",
            "back": "to play down / minimize",
            "example": "El ministro quiso minimizar el problema.",
