        ],
        "grammar": [
          {
            "sentence": "Un tribunal de China ha condenado a muerte a un alto funcionario de 69 años por haber aceptado sobornos que suman unos 325 millones de dólares.",
            "point": "por + infinitivo compuesto (causa)",
            "explanation": "por haber aceptado indica la causa de la condena; el infinitivo compuesto marca una acción terminada antes de la principal.",
            "why_tricky": "Los estudiantes usan por aceptar o una oración con porque aceptó, perdiendo el matiz de anterioridad."
          },
          {
            "sentence": "La corrupción, sin embargo, sigue siendo un problema difícil de erradicar, ya que socava la confianza en las instituciones y desvía recursos que deberían destinarse al bien común.",
            "point": "seguir + gerundio",
