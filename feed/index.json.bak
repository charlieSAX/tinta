            "example": "La guerra altero su vida cotidiana.",
            "tier": "B1"
          },
          {
            "front": "frente",
            "pos": "noun",
            "back": "front (military)",
            "example": "Los soldados volvieron del frente.",
            "tier": "B2"
          },
          {
            "front": "estar relacionado con",
            "pos": "phrase",
            "back": "to be linked / related to",
            "example": "El problema esta relacionado con el clima.",
            "tier": "B1"
          },
          {
