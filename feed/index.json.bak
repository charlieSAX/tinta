            "pos": "verb",
            "back": "to sentence, to convict",
            "example": "Lo condenaron a cinco años de cárcel.",
            "tier": "B2"
          },
          {
            "front": "la sentencia",
            "pos": "noun",
            "back": "verdict, sentence",
            "example": "La sentencia se conocerá mañana.",
