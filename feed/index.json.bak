            "pos": "noun",
            "back": "catch (of fish)",
            "example": "La captura de atún bajó este año.",
            "tier": "B1"
          },
          {
            "front": "disminuir",
            "pos": "verb",
            "back": "to decrease, to drop",
            "example": "Las ventas disminuyeron durante el invierno.",
            "tier": "B1"
          },
          {
