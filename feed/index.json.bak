      ],
      "pack": {
        "pack_id": "feed-2026-07-08-ciudades-calidad-vida",
        "revision": 1,
        "meta": {
          "title": "Cómo es vivir en las 5 ciudades con mayor calidad de vida en 2026",
          "source": "BBC Mundo",
          "url": "https://www.bbc.com/mundo/articles/c9v24gxl3nyo",
          "date_published": "2026-07-08",
          "date_processed": "2026-07-08",
          "tags": [
