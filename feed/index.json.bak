            "pos": "noun",
            "back": "larva",
            "example": "Las larvas se convierten en insectos.",
            "tier": "B2"
          },
          {
            "front": "carne mal cocinada",
            "pos": "phrase",
            "back": "undercooked meat",
            "example": "Es peligroso comer carne mal cocinada.",
            "tier": "B1"
          },
          {
