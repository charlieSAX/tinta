        "meta": {
          "title": "OTAN: anuncios de contratos por 50.000 millones de dólares para convencer a Trump",
          "source": "RFI Español",
          "url": "https://www.rfi.fr/es/europa/20260707-otan-anuncios-de-contratos-por-50-000-millones-de-d%C3%B3lares-para-convencer-a-trump",
          "date_published": "2026-07-07",
