            "pos": "adj",
            "back": "puzzling / baffling",
            "example": "Su reaccion fue realmente desconcertante.",
            "tier": "B2"
          },
          {
            "front": "contagiarse",
            "pos": "verb",
            "back": "to catch / get infected",
            "example": "Se contagio de gripe en el trabajo.",
            "tier": "B1"
          },
          {
