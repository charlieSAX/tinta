            "pos": "noun",
            "back": "fuel",
            "example": "El avion se quedo sin combustible.",
            "tier": "B1"
          },
          {
            "front": "estacion de servicio",
            "pos": "noun",
            "back": "service / petrol station",
            "example": "Paramos en una estacion de servicio.",
            "tier": "B1"
          },
          {
