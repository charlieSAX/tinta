            "pos": "phrase",
            "back": "luckily",
            "example": "Por suerte, no fue nada grave.",
            "tier": "B1"
          }
        ],
        "grammar": [
          {
            "sentence": "Al principio, nadie entendia que le ocurria.",
            "point": "imperfecto para acciones en desarrollo en el pasado",
            "explanation": "El imperfecto ('entendia', 'ocurria') describe situaciones o estados no acabados en el pasado.",
            "why_tricky": "El ingles suele usar 'past continuous' (was happening), pero el espanol prefiere el imperfecto simple."
          },
          {
