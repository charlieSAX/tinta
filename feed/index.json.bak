            "back": "prevention",
            "example": "La prevencion es clave en medicina.",
            "tier": "B1"
          },
          {
            "front": "recuperarse",
            "pos": "verb",
            "back": "to recover",
            "example": "Se recupero pronto tras la operacion.",
            "tier": "B1"
          },
          {
            "front": "darse cuenta de",
            "pos": "phrase",
            "back": "to realize",
            "example": "Me di cuenta del error demasiado tarde.",
            "tier": "B1"
          },
