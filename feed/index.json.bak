          },
          {
            "front": "la cumbre",
            "pos": "noun",
            "back": "summit (meeting of leaders)",
            "example": "La cumbre reunió a los líderes de treinta y dos países.",
            "tier": "B1"
          },
          {
            "front": "el gasto en defensa",
