        "Europa"
      ],
      "pack": {
        "pack_id": "feed-2026-08-04-ue-normas-ia",
        "revision": 1,
        "meta": {
          "title": "UE: Entran en vigor nuevas medidas para regular la inteligencia artificial",
          "source": "RFI Español",
          "url": "https://www.rfi.fr/es/europa/20260803-ue-entran-en-vigor-nuevas-medidas-para-regular-la-inteligencia-artificial",
          "date_published": "2026-08-03",
          "date_processed": "2026-08-04",
          "tags": [
            "tecnología",
            "Europa"
          ],
          "level": "B1-B2"
        },
        "summary_en": "New provisions of the European regulation on artificial intelligence, known as the AI Act, came into force on Sunday. With this pioneering law, the European Union is testing its ability to set the pace for a technology that is moving much faster than the rules. The new obligations mainly affect systems considered to carry the greatest risk, and the companies that develop them or place them on the European market.\n\nThe debate, however, is far from settled. On the one hand, a large part of the tech sector warns that excessive bureaucracy may hold back innovation and drive investment away. On the other, digital rights organisations argue that without clear rules it is impossible to protect citizens from opaque automated decisions. Over the coming months we will see to what extent the member states are capable of applying the regulation in a consistent way.",
        "resumen_es": "Desde este domingo han entrado en vigor nuevas disposiciones del reglamento europeo sobre inteligencia artificial, conocido como AI Act. Con esta ley pionera, la Unión Europea pone a prueba su capacidad para marcar el ritmo de una tecnología que avanza mucho más rápido que las normas. Las nuevas obligaciones afectan sobre todo a los sistemas considerados de mayor riesgo y a las empresas que los desarrollan o los ponen en el mercado europeo.\n\nEl debate, sin embargo, dista de estar cerrado. Por un lado, buena parte del sector tecnológico advierte de que un exceso de burocracia puede frenar la innovación y alejar inversiones. Por otro, las organizaciones de derechos digitales sostienen que sin reglas claras resulta imposible proteger a los ciudadanos frente a decisiones automatizadas opacas. En los próximos meses se verá hasta qué punto los Estados miembros son capaces de aplicar el reglamento de manera coherente.",
        "vocab": [
          {
            "front": "entrar en vigor",
            "pos": "phrase",
            "back": "to come into force, to take effect",
            "example": "La nueva normativa entrará en vigor el mes que viene.",
            "tier": "B2"
          },
          {
            "front": "disposición",
            "pos": "noun",
            "back": "provision, clause (in a law)",
            "example": "Las disposiciones del contrato son muy claras.",
            "tier": "B2"
          },
          {
            "front": "reglamento",
            "pos": "noun",
            "back": "regulation, set of rules",
            "example": "El reglamento europeo obliga a informar al usuario.",
            "tier": "B1"
          },
          {
            "front": "pionero",
            "pos": "adj",
            "back": "pioneering, groundbreaking",
            "example": "Fue un proyecto pionero en su sector.",
            "tier": "B2"
          },
          {
            "front": "poner a prueba",
            "pos": "phrase",
            "back": "to put to the test",
            "example": "La crisis puso a prueba al equipo entero.",
            "tier": "B1"
          },
          {
            "front": "marcar el ritmo",
            "pos": "phrase",
            "back": "to set the pace",
            "example": "China quiere marcar el ritmo en energías limpias.",
            "tier": "B2"
          },
          {
            "front": "distar de",
            "pos": "verb",
            "back": "to be far from (being something)",
            "example": "El acuerdo dista de ser perfecto.",
            "tier": "C1"
          },
          {
            "front": "advertir de",
            "pos": "verb",
            "back": "to warn about",
            "example": "Los médicos advierten del riesgo de deshidratación.",
            "tier": "B2"
          },
          {
            "front": "frenar",
            "pos": "verb",
            "back": "to slow down, to hold back",
            "example": "Los impuestos podrían frenar el consumo.",
            "tier": "B1"
          },
          {
            "front": "sostener (que)",
            "pos": "verb",
            "back": "to maintain, to argue (that)",
            "example": "El abogado sostiene que su cliente es inocente.",
            "tier": "B2"
          },
          {
            "front": "opaco",
            "pos": "adj",
            "back": "opaque, not transparent",
            "example": "El proceso de selección fue bastante opaco.",
            "tier": "B2"
          },
          {
            "front": "Estado miembro",
            "pos": "noun",
            "back": "member state (of the EU)",
            "example": "Cada Estado miembro aplica la directiva a su manera.",
            "tier": "B2"
          },
          {
            "front": "de manera coherente",
            "pos": "phrase",
            "back": "in a consistent way",
            "example": "Hay que actuar de manera coherente con lo prometido.",
            "tier": "B1"
          }
        ],
        "grammar": [
          {
            "sentence": "Desde este domingo han entrado en vigor nuevas disposiciones del reglamento europeo sobre inteligencia artificial, conocido como AI Act.",
            "point": "Pretérito perfecto with 'desde' plus inverted word order",
            "explanation": "Spanish uses the present perfect for events in a period that reaches the present, and here the subject 'nuevas disposiciones' comes after the verb, which is normal when new information is introduced.",
            "why_tricky": "English would say 'came into force on Sunday' with a simple past and subject first, so learners often produce 'entraron' and put the subject before the verb."
          },
          {
            "sentence": "Por otro, las organizaciones de derechos digitales sostienen que sin reglas claras resulta imposible proteger a los ciudadanos frente a decisiones automatizadas opacas.",
            "point": "Impersonal 'resulta imposible' plus infinitive",
            "explanation": "With expressions like resulta imposible, es difícil or es necesario, Spanish uses a bare infinitive when there is no specific subject.",
            "why_tricky": "Learners often insert 'que' and a subjunctive clause, which is only needed when a subject is named."
          },
          {
            "sentence": "En los próximos meses se verá hasta qué punto los Estados miembros son capaces de aplicar el reglamento de manera coherente.",
            "point": "Impersonal 'se' with future tense",
            "explanation": "'Se verá' means 'it will be seen' or 'we shall see', with no stated agent, a very common register in news writing.",
            "why_tricky": "The English equivalent needs a subject ('we will see'), so learners are tempted to write 'veremos' and lose the neutral tone."
          }
        ],
        "idioms": [
          {
            "phrase": "poner a prueba",
            "meaning": "to test something or someone under real pressure",
            "example": "El viaje puso a prueba nuestra paciencia."
          },
          {
            "phrase": "distar mucho de",
            "meaning": "to be nowhere near, to fall well short of",
            "example": "El resultado dista mucho de lo que esperábamos."
          }
        ],
        "comprehension": [
          {
            "q": "¿Qué pone a prueba la Unión Europea con el AI Act, según el texto?",
            "type": "open"
          },
          {
            "q": "¿Qué argumentos enfrentan al sector tecnológico y a las organizaciones de derechos digitales?",
            "type": "open"
          },
          {
            "q": "¿Por qué crees que el texto dice que el debate no está cerrado?",
            "type": "open"
          }
        ],
        "opinion_prompt": "¿Crees que regular la inteligencia artificial protege a los ciudadanos o frena la innovación? Escribe unas 120 palabras defendiendo tu postura con al menos dos argumentos."
      }
