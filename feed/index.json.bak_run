        "grammar": [
          {
            "sentence": "La ciudad española de Ceuta volvió a ser noticia después de que numerosas personas intentaran cruzar desde Marruecos hacia territorio europeo.",
            "point": "'Después de que' + subjuntivo",
            "explanation": "Tras 'después de que' se usa el subjuntivo ('intentaran') para referirse a la acción subordinada.",
            "why_tricky": "En el habla informal se oye el indicativo, pero la norma culta prefiere el subjuntivo."
