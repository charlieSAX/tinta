            "pos": "verb",
            "back": "to fit together",
            "example": "Las dos piezas encajan a la perfección.",
            "tier": "B1"
          },
          {
            "front": "la medida",
            "pos": "noun",
            "back": "measurement",
            "example": "Tomamos las medidas antes de comprar la mesa.",
            "tier": "B1"
          },
          {
            "front": "la normalización",
            "pos": "noun",
            "back": "standardization",
            "example": "La normalización facilitó el comercio internacional.",
            "tier": "B2"
          },
          {
